{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Inspect Lox highlighting",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${workspaceFolder}/.vscode-test/inspect-user",
        "--extensions-dir=${workspaceFolder}/.vscode-test/inspect-extensions",
        "--disable-extensions",
        "${workspaceFolder}/fixtures/highlighting.lox"
      ]
    }
  ]
}
