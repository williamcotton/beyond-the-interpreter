{
  "name": "rlox",
  "displayName": "Rlox — Lox Language",
  "description": "Lox language support for Beyond the Interpreter.",
  "version": "0.1.0",
  "publisher": "beyond-the-interpreter-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.128.0",
    "node": ">=22.23.4"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test:editor": "npm run build && node out/test/runEditor.js",
    "test": "npm run build && node --test out/test/grammar.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license --out rlox-0.1.0.vsix",
    "test:installed": "npm run build && node out/test/runEditor.js --installed"
  },
  "contributes": {
    "languages": [
      {
        "id": "lox",
        "aliases": [
          "Lox",
          "lox"
        ],
        "extensions": [
          ".lox"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lox",
        "scopeName": "source.lox",
        "path": "./syntaxes/lox.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "3.1.0",
    "typescript": "6.0.3",
    "vscode-textmate": "9.3.2",
    "vscode-oniguruma": "2.0.1",
    "@vscode/vsce": "4.1.0"
  },
  "type": "commonjs",
  "files": [
    "package.json",
    "README.md",
    "language-configuration.json",
    "syntaxes/lox.tmLanguage.json"
  ],
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  }
}
