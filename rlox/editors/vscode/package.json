{
  "name": "rlox",
  "displayName": "Rlox — Lox Language",
  "description": "Lox language support for Beyond the Interpreter.",
  "version": "0.1.0",
  "publisher": "beyond-the-interpreter-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.144.0",
    "node": ">=22.23.4"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test:editor": "npm run build && node out/test/runEditor.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "lox",
        "aliases": [
          "Lox",
          "lox"
        ],
        "extensions": [
          ".lox"
        ]
      }
    ]
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.144.0",
    "@vscode/test-electron": "3.1.0",
    "typescript": "6.0.3"
  },
  "type": "commonjs"
}
